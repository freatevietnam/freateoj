+            var orgUrlPattern = $contestData.data('org-url-pattern');
+            var problemUrl = orgId ? orgUrlPattern + orgId + '/' : publicUrl;
+            // Update all problem select2 widgets
+            $('select[id$="-problem"]').each(function() {
+                var $select = $(this);
+                // If select2 already initialized, we need to update its ajax URL
+                if ($select.data('select2')) {
+                    $select.select2('destroy');
+                }
+                $select.attr('data-ajax--url', problemUrl);
+                // Reinitialize select2 (the django-select2 JS should handle this)
+                $select.select2({
+                    ajax: {
+                        url: problemUrl,
+                    }
+                });
